        "import statistics\n",
        "member_names=[\"aman\",\"riya\",\"karan\",\"sneha\",\"rahul\"]\n",
        "age=[22,25,24,23,26]\n",
        "workout_hours=[2,1.5,2.5,1,3]\n",
        "calories_burned=[500,350,600,300,752]\n",
        "print(\"------Fitness center dataset--------\")\n",
        "print(\" dataset is loaded sucessfully\")\n",
        "for i in range(len(member_names)):\n",
        "    print(member_names[i],\n",
        "          age[i],\n",
        "          workout_hours[i],\n",
        "          calories_burned[i])\n",
        "    #average\n",
        "    average_workout=sum(workout_hours)/len(workout_hours)\n",
        "    print(\"average workout hours:\",average_workout)\n",
        "    average_calories=sum(calories_burned)/len(calories_burned)\n",
        "    print(\"average calories burned:\",average_calories)\n",
        "    #higgest\n",
        "    higgest_calories=max(calories_burned)\n",
        "    print(\"higgest calories burned=\",higgest_calories)\n",
        "    #lowest\n",
        "    lowest_calories=min(calories_burned)\n",
        "    print(\"lowest calories burned=\",lowest_calories)\n",
        "    #median\n",
        "    median_calories=statistics.median(calories_burned)\n",
        "    print(\"median calories burned=\",median_calories)\n",
        "    #standed deviation\n",
        "    std_dev=statistics.stdev(calories_burned)\n",
        "    print(\"standard deviation of calories burned=\",std_dev)\n",
        "    #active person\n",
        "    index=calories_burned.index(higgest_calories)\n",
        "    print(\"active person is\",member_names[index])\n",
        "    import matplotlib.pyplot as plt\n",
        "    plt.bar(member_names,calories_burned)\n",
        "    plt.xlabel(\"member names\")\n",
        "    plt.ylabel(\"calories burned\")\n",
        "    plt.title(\"fitness analysis\")\n",
        "    plt.show"
      ]
    }
